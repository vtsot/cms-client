{% extends 'base.html.twig' %}
{# @var \App\DTO\Data\SiteDTO site #}
{# @var \App\DTO\Data\Page\PageDetailsDTO page #}

{%- block title -%}
    {%- if page is defined and page is not null -%}
        {{ page.metaTitle|default(page.ogTitle)|default(page.title) }}
    {%- else -%}
        {{ parent() }}
    {%- endif -%}
{%- endblock -%}

{%- block seo -%}
    {%- if page is defined and page is not null -%}
        {%- if page.indexed == false -%}
            <meta name="robots" content="noindex, nofollow">
        {% endif -%}

        <meta name="description" content="{{ page.metaDescription }}">
        <meta name="keywords" content="{{ page.metaKeywords }}">
        <meta name="title" content="{{ page.metaTitle|default(page.title) }}">
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ page.ogTitle|default(page.title) }}">
        <meta property="og:description" content="{{ page.ogDescription|default(page.metaDescription) }}">
        {# <meta property="og:image" content="{{ page.ogImage ? absolute_url(page.ogImage) : asset('assets/images/logo.svg') }}">#}
        <meta property="og:url" content="{% block ogUrl %}{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}{% endblock %}">
        <meta property="og:locale" content="{{ app.request.locale }}">
    {%- else -%}
        {{ parent() }}
    {%- endif -%}
{%- endblock -%}


{%- block body -%}

    {% block content %}
        {% if page is defined and page is not null %}
            <h1>{{ page.title }}</h1>
            {{ page.content | raw }}
        {% endif %}
    {% endblock %}

{%- endblock -%}


{%- block before_body_end -%}
    {% if page is defined and page is not null %}
        {{ page.codeBlock | raw }}
    {%- else -%}
        {{ parent() }}
    {% endif %}

{%- endblock -%}
